<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest for the Microsoft Store build of PDFast.

  This is NOT consumed by the CMake build -- pdfviewer.exe is still a plain
  portable .exe (see CMakeLists.txt). This manifest is for the separate MSIX
  packaging step (MSIX Packaging Tool, or `makeappx pack`) that wraps the
  already-built PDFast.exe for Store submission. See resources/Assets/ for
  the referenced image assets and generate_assets.ps1 to regenerate them
  from icon.png.

  >>> Before packaging, replace the Identity/Publisher values below with the
  >>> ones assigned to your app in Partner Center (Product identity page). <<<
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap rescap">

  <Identity
      Name="REPLACE_WITH_PARTNER_CENTER_PACKAGE_IDENTITY_NAME"
      Publisher="REPLACE_WITH_PARTNER_CENTER_PUBLISHER_ID"
      Version="1.12.1.0" />

  <Properties>
    <DisplayName>PDFast</DisplayName>
    <PublisherDisplayName>REPLACE_WITH_PUBLISHER_DISPLAY_NAME</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>A fast, lightweight native PDF viewer and editor.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="PDFast" Executable="PDFast.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="PDFast"
          Description="A fast, lightweight native PDF viewer and editor."
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="transparent" />
      </uap:VisualElements>

      <Extensions>
        <!-- Declarative file-type association: replaces the app's own
             runtime HKCU registry writes for the packaged build (see
             pkginfo::IsPackaged() gating in src/viewer_window.cpp). The OS
             surfaces this in "Open with" / Default Apps without any
             self-registration code needing to run. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="pdfast.pdf">
            <uap:SupportedFileTypes>
              <uap:FileType>.pdf</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>PDF Document</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
